#!/usr/bin/env python3
"""Copy or move ROMs to PortareOS over SSH, converting disc images to CHD."""

from __future__ import annotations

import argparse
import errno
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zlib
from dataclasses import dataclass
from pathlib import Path

SUPPORTED = {".cue", ".gdi", ".iso", ".cso"}
ISO_IMAGES = {".iso", ".cso"}
ENCODED_AUDIO = {"MP3", "AIFF", "FLAC", "OGG"}
FILE_LINE = re.compile(r'\s*FILE\s+(?:"([^"]+)"|([^"\s]+))\s+(\S+)\s*', re.IGNORECASE)
TRACK_LINE = re.compile(r"\s*TRACK\s+\d+\s+(\S+)", re.IGNORECASE)


class ConversionError(Exception):
    """An actionable conversion failure, displayed without a traceback."""


@dataclass(frozen=True)
class CueFile:
    line: int
    source: Path
    kind: str


@dataclass(frozen=True)
class Job:
    source: Path
    output: Path
    container: str = "chd"


def read_cue(source: Path) -> tuple[list[str], list[CueFile]]:
    data = source.read_bytes()
    try:
        contents = data.decode("utf-8-sig")
    except UnicodeDecodeError:
        contents = data.decode("cp1252", errors="replace")
    lines = contents.splitlines()
    files: list[CueFile] = []
    tracks = 0
    for number, line in enumerate(lines):
        if re.match(r"\s*FILE\b", line, re.IGNORECASE):
            match = FILE_LINE.fullmatch(line)
            if not match:
                raise ConversionError(f"{source.name}:{number + 1}: invalid FILE line")
            name = match[1] or match[2]
            target = source.parent / name
            if not target.is_file():
                # CUE sheets distributed for Windows often use backslashes.
                target = source.parent / name.replace("\\", "/")
            kind = match[3].upper()
            if kind not in {"BINARY", "MOTOROLA", "WAVE"} | ENCODED_AUDIO:
                raise ConversionError(
                    f"{source.name}: unsupported CUE file type: {kind}"
                )
            files.append(CueFile(number, target.resolve(), kind))
        track = TRACK_LINE.match(line)
        if track:
            if not files:
                raise ConversionError(f"{source.name}: TRACK appears before FILE")
            if files[-1].kind in ENCODED_AUDIO and track[1].upper() != "AUDIO":
                raise ConversionError(
                    f"{source.name}: encoded audio must use TRACK AUDIO"
                )
            tracks += 1
    if not files or not tracks:
        raise ConversionError(f"{source.name}: CUE must contain FILE and TRACK entries")
    return lines, files


def plan_jobs(inputs: list[Path], output: Path | None, recursive: bool) -> list[Job]:
    jobs: dict[Path, Job] = {}
    for argument in inputs:
        source = argument.expanduser().resolve()
        if source.is_dir():
            candidates = source.rglob("*") if recursive else source.iterdir()
            images = sorted(
                (
                    p
                    for p in candidates
                    if p.is_file() and p.suffix.lower() in SUPPORTED
                ),
                key=lambda p: str(p).casefold(),
            )
            for image in images:
                destination = (
                    output / image.relative_to(source).with_suffix(".chd")
                    if output
                    else image.with_suffix(".chd")
                )
                jobs.setdefault(image.resolve(), Job(image.resolve(), destination))
        elif source.is_file():
            if source.suffix.lower() not in SUPPORTED:
                raise ConversionError(
                    f"Unsupported input: {source.name}. Select a .cue, .gdi, .iso or .cso; "
                    "for BIN or audio tracks, select their CUE sheet."
                )
            destination = (
                output / source.with_suffix(".chd").name
                if output
                else source.with_suffix(".chd")
            )
            jobs.setdefault(source, Job(source, destination))
        else:
            raise ConversionError(f"Input does not exist: {source}")

    # An ISO referenced by a CUE is part of that disc, not a separate game.
    referenced: set[Path] = set()
    for job in jobs.values():
        if job.source.suffix.lower() == ".cue":
            try:
                _, files = read_cue(job.source)
            except (ConversionError, OSError):
                continue  # Report a broken disc when its conversion is attempted.
            referenced.update(entry.source for entry in files)
    planned = [
        Job(job.source, job.output.with_name(job.output.name.replace(" ", "_")))
        for job in jobs.values()
        if job.source not in referenced
    ]
    if not planned:
        raise ConversionError(
            "No .cue, .gdi, .iso or .cso images found. Use --recursive to search subfolders."
        )
    destinations: dict[str, Path] = {}
    for job in planned:
        # Also catch collisions on the usual case-insensitive macOS volumes.
        key = str(job.output.resolve()).casefold()
        if key in destinations:
            raise ConversionError(
                f"Output collision: {destinations[key]} and {job.source} both map to {job.output}. "
                "Convert separately or use a common input folder with --recursive."
            )
        destinations[key] = job.source
    return planned


CSO_MAGIC = b"CISO"
CSO_PLAIN = 0x80000000


def cso_layout(source: Path) -> tuple[int, int, int, list[int]]:
    """Read a CSO v1 header and index: image size, block size, shift, index."""
    with source.open("rb") as image:
        header = image.read(24)
        if len(header) != 24 or header[:4] != CSO_MAGIC:
            raise ConversionError(f"{source.name}: not a CSO image")
        total, block_size = struct.unpack_from("<QI", header, 8)
        version, align = header[20], header[21]
        if version > 1:
            raise ConversionError(
                f"{source.name}: CSO version {version} is not supported; "
                "decompress it to an ISO first (maxcso --decompress)."
            )
        if not block_size or block_size % 2048:
            raise ConversionError(f"{source.name}: unsupported CSO block size {block_size}")
        blocks = -(-total // block_size)
        raw = image.read(4 * (blocks + 1))
        if len(raw) != 4 * (blocks + 1):
            raise ConversionError(f"{source.name}: truncated CSO index")
    return total, block_size, align, list(struct.unpack(f"<{blocks + 1}I", raw))


def cso_blocks(source: Path, first: int = 0, count: int | None = None):
    """Yield a CSO's blocks decompressed, each block_size bytes but the last."""
    total, block_size, align, index = cso_layout(source)
    end_block = len(index) - 1 if count is None else min(len(index) - 1, first + count)
    with source.open("rb") as image:
        for number in range(first, end_block):
            start = (index[number] & ~CSO_PLAIN) << align
            end = (index[number + 1] & ~CSO_PLAIN) << align
            image.seek(start)
            data = image.read(end - start)
            size = min(block_size, total - number * block_size)
            if index[number] & CSO_PLAIN:
                block = data[:size]
            else:
                try:
                    # Raw deflate; the stream may be followed by alignment padding.
                    block = zlib.decompressobj(-15).decompress(data, size)
                except zlib.error as error:
                    raise ConversionError(
                        f"{source.name}: corrupt CSO block {number}: {error}"
                    ) from error
            if len(block) != size:
                raise ConversionError(f"{source.name}: corrupt CSO block {number}")
            yield block


def decompress_cso(source: Path, target: Path) -> Path:
    with target.open("wb") as image:
        for block in cso_blocks(source):
            image.write(block)
    return target


def disc_probe(source: Path) -> tuple[int, bytes]:
    """Image size and the 2048-byte sector 16 (ISO9660 PVD) of an ISO or CSO."""
    if source.suffix.lower() == ".cso":
        total, block_size, _, _ = cso_layout(source)
        offset = 16 * 2048
        block = b"".join(cso_blocks(source, offset // block_size, 1))
        start = offset % block_size
        return total, block[start : start + 2048]
    with source.open("rb") as image:
        image.seek(16 * 2048)
        return source.stat().st_size, image.read(2048)


def find_tool(name: str, override: str | None) -> str:
    candidate = override or os.environ.get(name.upper()) or name
    executable = shutil.which(os.path.expanduser(candidate))
    if executable:
        return str(Path(executable).resolve())
    raise ConversionError(
        f"Cannot find {name}: {candidate}. On macOS: brew install rom-tools ffmpeg. "
        "On Debian/Ubuntu: sudo apt install mame-tools ffmpeg. "
        f"Or set {name.upper()}=/path/to/{name}."
    )


def run(command: list[str], *, cwd: Path | None = None) -> None:
    try:
        subprocess.run(command, cwd=cwd, stdin=subprocess.DEVNULL, check=True)
    except subprocess.CalledProcessError as error:
        raise ConversionError(
            f"{Path(command[0]).name} failed (exit {error.returncode}); see output above."
        ) from error


def prepare_cue(source: Path, work: Path, ffmpeg: str | None) -> Path:
    lines, files = read_cue(source)
    for entry in files:
        if not entry.source.is_file():
            raise ConversionError(
                f"Missing track referenced by {source.name}: {entry.source}"
            )

    # Short local symlinks keep paths portable and avoid copying large BIN/ISO files.
    prepared: dict[tuple[Path, str], str] = {}
    for entry in files:
        key = (entry.source, entry.kind)
        if key not in prepared:
            number = len(prepared) + 1
            if entry.kind in ENCODED_AUDIO:
                executable = find_tool("ffmpeg", ffmpeg)
                name = f"audio-{number:03d}.wav"
                print(f"  Preparing audio: {entry.source.name}", flush=True)
                run(
                    [
                        executable,
                        "-hide_banner",
                        "-loglevel",
                        "error",
                        "-nostdin",
                        "-i",
                        str(entry.source),
                        "-map",
                        "0:a:0",
                        "-vn",
                        "-ac",
                        "2",
                        "-af",
                        "aresample=44100,asetnsamples=n=588:p=1",
                        "-ar",
                        "44100",
                        "-c:a",
                        "pcm_s16le",
                        str(work / name),
                    ]
                )
                # 588 stereo samples = one 2352-byte CD sector. The filter pads
                # the last sector with silence so chdman won't truncate samples.
            else:
                name = f"source-{number:03d}{entry.source.suffix}"
                try:
                    (work / name).symlink_to(entry.source)
                except OSError as error:
                    if error.errno not in {errno.EPERM, errno.EOPNOTSUPP, errno.ENOSYS}:
                        raise
                    shutil.copyfile(entry.source, work / name)
            prepared[key] = name
        kind = "WAVE" if entry.kind in ENCODED_AUDIO else entry.kind
        lines[entry.line] = f'FILE "{prepared[key]}" {kind}'
    cue = work / "disc.cue"
    cue.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return cue


def publish(staged: Path, output: Path, overwrite: bool) -> None:
    if overwrite:
        os.replace(staged, output)
        return
    try:
        # Unlike rename(), link() atomically refuses an existing destination.
        os.link(staged, output)
    except OSError as error:
        if error.errno not in {
            errno.EPERM,
            errno.EOPNOTSUPP,
            errno.ENOSYS,
            errno.EXDEV,
        }:
            raise
        # FAT/exFAT output volumes cannot hard-link; exclusive creation still
        # protects existing files, and interrupted copies remove their output.
        with output.open("xb") as destination:
            try:
                with staged.open("rb") as source:
                    shutil.copyfileobj(source, destination)
                destination.flush()
            except BaseException:
                output.unlink()
                raise


def convert(job: Job, args: argparse.Namespace, chdman: str) -> bool:
    if os.path.lexists(job.output) and not args.overwrite:
        print(f"Skipped existing: {job.output}", flush=True)
        return False
    job.output.parent.mkdir(parents=True, exist_ok=True)
    print(f"Converting: {job.source}\n        to: {job.output}", flush=True)
    with tempfile.TemporaryDirectory(
        prefix=".portare-chd-", dir=job.output.parent
    ) as temporary:
        work = Path(temporary)
        suffix = job.source.suffix.lower()
        if suffix == ".cue":
            image = prepare_cue(job.source, work, args.ffmpeg)
        elif suffix == ".cso":
            print("  Decompressing CSO…", flush=True)
            image = decompress_cso(job.source, work / "disc.iso")
        else:
            image = job.source
        command = (
            "createdvd" if suffix in ISO_IMAGES and args.iso_type == "dvd" else "createcd"
        )
        staged = work / "output.chd"
        options = [chdman, command, "-i", str(image), "-o", str(staged)]
        # Use established codecs supported by handheld emulators' libchdr.
        codecs = "lzma,zlib,huff,flac" if command == "createdvd" else "cdlz,cdzl,cdfl"
        options.extend(["-c", codecs])
        if args.jobs:
            options.extend(["-np", str(args.jobs)])
        run(options, cwd=work)
        if not args.no_verify:
            print("  Verifying CHD…", flush=True)
            run([chdman, "verify", "-i", str(staged)])
        publish(staged, job.output, args.overwrite)
    print(
        f"Created: {job.output} ({job.output.stat().st_size / (1024 * 1024):.1f} MiB)",
        flush=True,
    )
    return True


def find_dolphin_tool() -> str:
    candidates = [os.environ.get("DOLPHIN_TOOL")] if os.environ.get("DOLPHIN_TOOL") else [
        "dolphin-tool",
        "/usr/games/dolphin-tool",  # Debian and Ubuntu's dolphin-emu package
    ]
    for candidate in candidates:
        executable = shutil.which(os.path.expanduser(candidate))
        if executable:
            return str(Path(executable).resolve())
    raise ConversionError(
        "Cannot find dolphin-tool, which converts GameCube and Wii images to RVZ. "
        "Dolphin's macOS app does not include it: convert in Dolphin instead "
        "(right-click the game, Convert File..., format RVZ, Zstandard, level 5, "
        "block size 128 KiB) and push the .rvz. On Debian/Ubuntu: "
        "sudo apt install dolphin-emu. Or set DOLPHIN_TOOL=/path/to/dolphin-tool."
    )


def disc_sha1(tool: str, image: Path, user: Path) -> str:
    """SHA-1 of the disc an image decodes to, whatever its container."""
    result = subprocess.run(
        [tool, "verify", "-u", str(user), "-i", str(image), "-a", "sha1"],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        check=False,
    )
    digest = result.stdout.strip().split()[-1] if result.stdout.strip() else ""
    if result.returncode or not re.fullmatch(r"[0-9a-f]{40}", digest):
        raise ConversionError(
            f"dolphin-tool could not read {image.name}: "
            f"{(result.stderr or result.stdout).strip()}"
        )
    return digest


def convert_rvz(job: Job, tool: str) -> bool:
    if os.path.lexists(job.output):
        print(f"Skipped existing: {job.output}", flush=True)
        return False
    job.output.parent.mkdir(parents=True, exist_ok=True)
    print(f"Converting: {job.source}\n        to: {job.output}", flush=True)
    with tempfile.TemporaryDirectory(
        prefix=".portare-rvz-", dir=job.output.parent
    ) as temporary:
        work = Path(temporary)
        # dolphin-tool keeps temporary files in a user folder; not ~/.
        user = work / "user"
        staged = work / "output.rvz"
        run([tool, "convert", "-u", str(user), "-i", str(job.source),
             "-o", str(staged), *RVZ_OPTIONS])
        print("  Verifying RVZ…", flush=True)
        expected = disc_sha1(tool, job.source, user)
        actual = disc_sha1(tool, staged, user)
        if actual != expected:
            raise ConversionError(
                f"{job.source.name}: RVZ verification failed: the RVZ decodes to "
                f"SHA-1 {actual}, the source to {expected}"
            )
        publish(staged, job.output, False)
    print(
        f"Created: {job.output} ({job.output.stat().st_size / (1024 * 1024):.1f} MiB)",
        flush=True,
    )
    return True


