# GameCube and Wii games are RVZ, Dolphin's lossless format: it regenerates the
# discs' pseudo-random padding and stores Wii data decrypted, neither of which
# CHD can compress. dolphin-tool converts the other image formats.
DOLPHIN_SYSTEMS = {"gamecube", "triforce", "wii", "wiiware"}
DOLPHIN_IMAGES = {".iso", ".gcm", ".gcz", ".wbfs", ".ciso", ".wia"}
DOLPHIN_KEEP = {".rvz", ".dol"}  # .dol homebrew has no disc
WII_CHANNEL_SYSTEMS = {"wii", "wiiware"}  # .wad channels are not discs either
RVZ_OPTIONS = ["-f", "rvz", "-c", "zstd", "-l", "5", "-b", "131072"]
PS2_SYSTEMS = {"ps2", "armsx2"}
DVD_SYSTEMS = PS2_SYSTEMS | {"psp", "pspminis", "xbox"}


@dataclass(frozen=True)
class Transfer:
    source: Path
    upload: Path
    conversion: Job | None = None


def detect_ps2_iso_type(source: Path) -> str:
    """Apply PCSX2's CD/DVD heuristic to a cooked, 2048-byte-sector ISO or CSO."""
    size, descriptor = disc_probe(source)
    sectors, remainder = divmod(size, 2048)
    if remainder or len(descriptor) != 2048 or descriptor[:7] != b"\x01CD001\x01":
        raise ConversionError(
            f"Cannot detect PS2 CD/DVD media type: {source.name}; "
            "expected an ISO9660 image with 2048-byte sectors. "
            "Select the CUE for raw CD tracks, or use --iso-type cd or --iso-type dvd "
            "for an image with nonstandard metadata."
        )

    # PCSX2/CDVD/CDVDcommon.cpp::FindDiskType: images beyond this sector
    # count are DVDs. Smaller images use the root directory length in the PVD.
    # https://github.com/PCSX2/pcsx2/blob/master/pcsx2/CDVD/CDVDcommon.cpp
    if sectors > 452849:
        return "dvd"
    root_size = int.from_bytes(descriptor[166:170], "little")
    if not root_size or root_size != int.from_bytes(descriptor[170:174], "big"):
        raise ConversionError(
            f"Cannot detect PS2 CD/DVD media type: {source.name}; "
            "invalid ISO9660 root directory length. "
            "Use --iso-type cd or --iso-type dvd to override."
        )
    return "cd" if descriptor[166:168] == descriptor[171:173] else "dvd"


def media_type(source: Path, system: str, iso_type: str) -> str:
    if source.suffix.lower() not in ISO_IMAGES:
        return "cd"  # CUE/GDI always describe CDs.
    if iso_type != "auto":
        return iso_type
    if system.casefold() in PS2_SYSTEMS:
        return detect_ps2_iso_type(source)
    return "cd" if system.casefold() in CD_SYSTEMS else "dvd"


def plan_rvz_transfers(system: str, sources: list[Path], output: Path) -> list[Transfer]:
    transfers = []
    for source in sources:
        extension = source.suffix.lower()
        if extension in DOLPHIN_KEEP or (
            extension == ".wad" and system in WII_CHANNEL_SYSTEMS
        ):
            transfers.append(Transfer(source, source))
        elif extension in DOLPHIN_IMAGES:
            name = source.with_suffix(".rvz").name.replace(" ", "_")
            job = Job(source, output / name, "rvz")
            transfers.append(Transfer(source, job.output, job))
        else:
            raise ConversionError(
                f"GameCube and Wii games are RVZ: {source.name}. Supply an .rvz, or an "
                "ISO/GCM/GCZ/WBFS/CISO/WIA image to convert"
                + (" (.wad channels are copied as they are)." if system in WII_CHANNEL_SYSTEMS else ".")
            )
    return transfers


def plan_transfers(system: str, sources: list[Path], output: Path) -> list[Transfer]:
    system = system.casefold()
    if system in DOLPHIN_SYSTEMS:
        return check_names(plan_rvz_transfers(system, sources, output))
    images = []
    passthrough = []
    for source in sources:
        extension = source.suffix.lower()
        if extension == ".chd" or (
            system in CARTRIDGE_SYSTEMS and extension in CARTRIDGE_FORMATS
        ):
            passthrough.append(Transfer(source, source))
        elif extension in SUPPORTED and system in CD_SYSTEMS | DVD_SYSTEMS and (
            # CSO holds 2048-byte sectors: PSP, PS2 and Xbox images, not CDs.
            extension != ".cso" or system in DVD_SYSTEMS
        ):
            images.append(source)
        else:
            raise ConversionError(
                f"Non-CHD transfers are only allowed for cartridge ROMs: {source.name}. "
                "For supported disc systems, supply a CHD or an ISO/CUE/GDI (CSO for "
                "PS2, PSP and Xbox) to convert. "
                "Select the CUE sheet for BIN/audio tracks; extract disc archives first."
            )

    jobs = plan_jobs(images, output, False) if images else []
    planned = {job.source: Transfer(job.source, job.output, job) for job in jobs}
    planned.update({item.source.resolve(): item for item in passthrough})
    # plan_jobs excludes ISOs referenced by a selected CUE sheet.
    transfers = [
        planned[source.resolve()] for source in sources if source.resolve() in planned
    ]
    return check_names(transfers)


def check_names(transfers: list[Transfer]) -> list[Transfer]:
    names = set()
    for item in transfers:
        name = item.upload.name.casefold()
        if name in names:
            raise ConversionError(f"duplicate destination filename: {item.upload.name}")
        names.add(name)
    return transfers


def push(
    host: str,
    system: str,
    transfers: list[Transfer],
    *,
    move: bool,
    dry_run: bool,
    iso_type: str = "auto",
) -> int:
    # Probe the entire batch before converting or uploading any of it.
    conversions = [
        (item, media_type(item.source, system, iso_type))
        for item in transfers
        if item.conversion and item.conversion.container == "chd"
    ]
    rvz_conversions = [
        item for item in transfers if item.conversion and item.conversion.container == "rvz"
    ]
    chdman = find_tool("chdman", None) if conversions and not dry_run else None
    dolphin_tool = find_dolphin_tool() if rvz_conversions and not dry_run else None
    destination = f"/storage/roms/{system}/"
    if subprocess.run(["ssh", host, f"test -d {destination}"], check=False).returncode:
        print(
            f"nova-push: cannot access {host}:{destination}; "
            "check SSH and use --list to see system folders",
            file=sys.stderr,
        )
        return 1

    for item, selected_type in conversions:
        if dry_run:
            print(
                f"nova-push: would convert and verify {item.source} "
                f"-> {host}:{destination}{item.upload.name} (chdman create{selected_type})",
                flush=True,
            )
        else:
            print(
                f"nova-push: {item.source.name}: using chdman create{selected_type}",
                flush=True,
            )
            args = argparse.Namespace(
                iso_type=selected_type,
                ffmpeg=None,
                jobs=None,
                no_verify=False,
                overwrite=False,
            )
            convert(item.conversion, args, chdman)

    for item in rvz_conversions:
        if dry_run:
            print(
                f"nova-push: would convert and verify {item.source} "
                f"-> {host}:{destination}{item.upload.name} (dolphin-tool convert to RVZ)",
                flush=True,
            )
        else:
            print(f"nova-push: {item.source.name}: using dolphin-tool convert to RVZ", flush=True)
            convert_rvz(item.conversion, dolphin_tool)

    # A dry run previews future CHDs above; rsync needs actual source files.
    uploads = [item for item in transfers if not (dry_run and item.conversion)]
    if uploads:
        options = ["-th", "--progress", "--partial-dir=.nova-push-partial", "--rsh=ssh"]
        if move:
            options.extend(["--checksum", "--remove-source-files"])
        if dry_run:
            options.append("--dry-run")
        status = subprocess.run(
            [
                "rsync",
                *options,
                "--",
                *(str(item.upload) for item in uploads),
                f"{host}:{destination}",
            ],
            check=False,
        ).returncode
        if status:
            return status if status > 0 else 128 - status

    if move and not dry_run:
        for item, _ in conversions:
            # rsync removes a staged CHD only after confirming its delivery.
            # A failed batch retains every original conversion input.
            if not item.upload.exists():
                item.source.unlink()

    action = (
        "dry run; no files copied or removed"
        if dry_run
        else "moved"
        if move
        else "copied"
    )
    print(f"nova-push: {len(transfers)} file(s) -> {host}:{destination} ({action})")
    return 0


class UsageError(Exception):
    """Invalid command-line arguments or configuration."""


INFERRED_SYSTEMS = {
    extension: system
    for system, extensions in {
        "nes": ("nes",),
        "snes": ("sfc", "smc"),
        "gb": ("gb",),
        "gbc": ("gbc",),
        "gba": ("gba",),
        "n64": ("z64", "n64", "v64"),
        "nds": ("nds",),
        "megadrive": ("md", "gen"),
        "pcengine": ("pce",),
        "virtualboy": ("vb",),
        "ngpc": ("ngp", "ngc"),
        "wonderswancolor": ("ws", "wsc"),
        "gamegear": ("gg",),
        "mastersystem": ("sms",),
    }.items()
    for extension in extensions
}


def cli_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="nova-push",
        usage="%(prog)s [options] [system] file ...\n"
        "       %(prog)s [--host [user@]host] --list\n"
        "       %(prog)s --set-host [user@]host",
        description="Copy files into /storage/roms/<system>/ on a PortareOS device. "
        "ISO/CUE/GDI disc images, and CSO for PS2, PSP and Xbox, are converted to "
        "verified CHDs first; GameCube and Wii images to verified RVZ with dolphin-tool. "
        "Cartridge ROMs are copied unchanged; other disc formats are rejected.",
        epilog="Omit the system only when every file extension identifies the same system. "
        "Host priority: --host, then NOVA, then the saved default in "
        "${XDG_CONFIG_HOME:-$HOME/.config}/nova-push/host. "
        "Requires Python 3.10+, SSH, and rsync locally, and rsync on the device. "
        "Conversion also requires chdman (and FFmpeg for encoded CUE audio). "
        "Use an SSH config alias for custom ports, keys, or IPv6 addresses.",
    )
    parser.add_argument("-H", "--host", help="SSH destination for this command")
    parser.add_argument(
        "--set-host", metavar="HOST", help="save a default SSH destination"
    )
    parser.add_argument(
        "-m",
        "--move",
        action="store_true",
        help="remove local inputs after confirmed delivery",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="preview conversions and transfers without changing files",
    )
    parser.add_argument(
        "--iso-type",
        type=str.lower,
        choices=("auto", "cd", "dvd"),
        help="ISO media type (default: auto; detects PS2 CD/DVD)",
    )
    parser.add_argument(
        "-l", "--list", action="store_true", help="list the device's system folders"
    )
    parser.add_argument("inputs", nargs="*", metavar="system/file")
    return parser


def host_config() -> Path:
    config_home = os.environ.get("XDG_CONFIG_HOME")
    if not config_home:
        home = os.environ.get("HOME")
        if not home:
            raise UsageError("set HOME or XDG_CONFIG_HOME to locate the saved host")
        config_home = str(Path(home) / ".config")
    if not Path(config_home).is_absolute():
        raise UsageError("XDG_CONFIG_HOME must be an absolute path")
    return Path(config_home) / "nova-push" / "host"


def resolve_host(args: argparse.Namespace) -> str:
    if args.host == "" or args.set_host == "":
        raise UsageError("--host and --set-host require a host")
    host = (
        args.set_host
        if args.set_host is not None
        else args.host or os.environ.get("NOVA", "")
    )
    if not host:
        config = host_config()
        if config.is_file():
            host = config.read_text().rstrip("\n")
    if not host:
        raise UsageError(
            "run nova-push --set-host [user@]host, set NOVA, or pass --host [user@]host"
        )
    if not re.fullmatch(
        r"([a-zA-Z0-9_][a-zA-Z0-9_.-]*@)?[a-zA-Z0-9_][a-zA-Z0-9_.-]*", host
    ):
        raise UsageError("invalid host; use [user@]hostname or an SSH config alias")
    return host


def save_host(host: str) -> None:
    config = host_config()
    config.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".host.", dir=config.parent)
    try:
        with os.fdopen(descriptor, "w") as output:
            output.write(host + "\n")
        os.replace(temporary, config)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print(f"nova-push: saved default host {host} in {config}")


def infer_system(source: Path) -> str:
    system = INFERRED_SYSTEMS.get(source.suffix.lower().lstrip("."))
    if system is None:
        raise UsageError(
            f"ambiguous extension: {source}; specify a system (nova-push <system> <files...>)"
        )
    return system


def prepare_inputs(inputs: list[str]) -> tuple[str, list[Path]]:
    infer = Path(inputs[0]).is_file()
    system = infer_system(Path(inputs[0])) if infer else inputs[0]
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", system):
        raise UsageError(f"invalid system folder: {system}")
    arguments = inputs if infer else inputs[1:]
    if not arguments:
        raise UsageError("no files supplied")
    sources = []
    names = set()
    for argument in arguments:
        source = Path(argument)
        if not source.is_file() or source.is_symlink():
            raise UsageError(f"expected a regular file (not a symlink): {source}")
        if infer and infer_system(source) != system:
            raise UsageError(
                "files identify different systems; specify a system or transfer separately"
            )
        if source.name.casefold() in names:
            raise UsageError(f"duplicate destination filename: {source.name}")
        names.add(source.name.casefold())
        # Absolute paths avoid rsync's option/remote-host syntax for local files.
        sources.append(source.absolute())
    return system, sources


def main(argv: list[str] | None = None) -> int:
    parser = cli_parser()
    args = parser.parse_args(argv)
    try:
        if args.set_host is not None:
            if (
                args.inputs
                or args.host is not None
                or args.list
                or args.move
                or args.dry_run
                or args.iso_type is not None
            ):
                raise UsageError("--set-host must be used on its own")
        elif args.list:
            if args.inputs or args.move or args.dry_run or args.iso_type is not None:
                raise UsageError(
                    "--list cannot be combined with files, --move, --dry-run, or --iso-type"
                )
        elif not args.inputs:
            parser.print_usage(sys.stderr)
            return 2
        host = resolve_host(args)
        if args.set_host is not None:
            save_host(host)
            return 0
        if args.list:
            if not shutil.which("ssh"):
                raise UsageError("ssh is required")
            return subprocess.run(
                ["ssh", host, "ls -1 /storage/roms"], check=False
            ).returncode
        system, sources = prepare_inputs(args.inputs)
        for tool in ("ssh", "rsync"):
            if not shutil.which(tool):
                raise UsageError(f"{tool} is required")
        with tempfile.TemporaryDirectory(prefix="nova-push-") as temporary:
            try:
                transfers = plan_transfers(system, sources, Path(temporary))
            except ConversionError as error:
                raise UsageError(str(error)) from error
            return push(
                host,
                system,
                transfers,
                move=args.move,
                dry_run=args.dry_run,
                iso_type=args.iso_type or "auto",
            )
    except UsageError as error:
        parser.error(str(error))
    except (ConversionError, OSError, UnicodeError) as error:
        print(f"nova-push: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nnova-push: interrupted; temporary CHDs removed.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
